VITE_APP_TITLE=Python 100 天 · 学习导航台
VITE_BASE=/

# 以下变量由 scripts/sync-content.mjs 读取（不进前端包）
CONTENT_REPO=https://github.com/jackfrued/Python-100-Days.git
CONTENT_REF=master
CONTENT_DIR=../Python-100-Days
CONTENT_OUT=public/content
CONTENT_ASSETS=copy
# 使用 CONTENT_ASSETS=remote 且源仓库不在 GitHub 时必须设置，例如：https://cdn.example.com/Python-100-Days/master/
# CONTENT_ASSETS_BASE=
